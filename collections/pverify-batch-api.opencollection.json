{
  "opencollection": "1.0.0",
  "info": {
    "name": "pVerify Authentication Batch API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit a batch of eligibility verifications",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pverify.com/API/BatchEligibility",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits multiple eligibility verifications in a single request for asynchronous processing; results are retrieved later by batch reference."
        }
      ]
    }
  ],
  "bundled": true
}