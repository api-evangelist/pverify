{
  "opencollection": "1.0.0",
  "info": {
    "name": "pVerify Authentication Payers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List supported payers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pverify.com/API/Payers"
          },
          "docs": "Returns the current pVerify payer list with codes, names, and capability flags used to map a request to a supported insurer."
        }
      ]
    }
  ],
  "bundled": true
}